<!--
  앱 전체 설정.
  StartupUri : 프로그램이 시작되면 MainWindow.xaml 을 띄운다.
  Application.Resources 의 스타일은 모든 화면에 공통으로 적용된다.
  (x:Key 가 없는 스타일은 그 종류의 컨트롤 전체에, x:Key 가 있는 스타일은 Style="{StaticResource 키}" 로 고른 곳에만 적용)
-->
<Application x:Class="ShoppingMall.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>

    <!-- 버튼: 최소 폭과 안쪽 여백을 맞춰 크기가 들쭉날쭉하지 않게 -->
    <Style TargetType="Button">
      <Setter Property="MinWidth" Value="80" />
      <Setter Property="Padding" Value="12,5" />
    </Style>

    <!-- 입력칸: 글자가 칸 가운데에 오도록 -->
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="4,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="4,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Padding" Value="6,4" />
    </Style>

    <!-- 화면 제목 ([상품페이지] 등) -->
    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 폼의 왼쪽 라벨 -->
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <!--
      표(DataGrid): 모든 표를 읽기 전용, 한 줄 선택, 열은 XAML 에 직접 정의(AutoGenerateColumns=False)로 통일한다.
      CanUserAddRows=False : 맨 아래 "새 행 추가" 빈 줄을 없앤다.
    -->
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="SelectionMode" Value="Single" />
      <Setter Property="SelectionUnit" Value="FullRow" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0" />
      <Setter Property="RowHeight" Value="30" />
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderBrush" Value="#CCCCCC" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="Background" Value="#F3F3F3" />
      <Setter Property="BorderBrush" Value="#DDDDDD" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
    </Style>
    <!-- 칸 안쪽 여백 + 세로 가운데 정렬. 선택 색은 기본 스타일(BasedOn)의 것을 그대로 쓴다. -->
    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridCell">
            <Border Padding="8,0" Background="{TemplateBinding Background}" BorderThickness="0">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

  </Application.Resources>
</Application>
