<!-- 내 정보: 회원정보 조회·수정 / 회원탈퇴 / 로그아웃. 아이디는 바꿀 수 없어서 글자로만 보여준다. -->
<UserControl x:Class="ShoppingMall.Client.Views.MemberView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel Margin="12" MaxWidth="560" HorizontalAlignment="Left">
    <TextBlock x:Name="GreetingText" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" MinWidth="320" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource Label}" />
      </Grid.Resources>

      <TextBlock Text="아이디" />
      <TextBlock x:Name="LoginIdText" Grid.Column="1" />

      <TextBlock Text="이름" Grid.Row="1" Margin="0,8,12,0" />
      <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" />

      <TextBlock Text="주소" Grid.Row="2" Margin="0,8,12,0" />
      <TextBox x:Name="AddressBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" />

      <TextBlock Text="이메일" Grid.Row="3" Margin="0,8,12,0" />
      <TextBox x:Name="EmailBox" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" />

      <TextBlock Text="전화번호" Grid.Row="4" Margin="0,8,12,0" />
      <TextBox x:Name="PhoneBox" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" />

      <TextBlock Text="성별" Grid.Row="5" Margin="0,8,12,0" />
      <ComboBox x:Name="GenderBox" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" SelectedIndex="0">
        <ComboBoxItem Content="선택 안 함" />
        <ComboBoxItem Content="남성" />
        <ComboBoxItem Content="여성" />
      </ComboBox>
    </Grid>

    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
      <Button Content="정보수정" Click="Update_Click" />
      <Button Content="회원탈퇴" Click="Withdraw_Click" Margin="8,0,0,0" />
      <Button Content="로그아웃" Click="Logout_Click" Margin="8,0,0,0" />
    </StackPanel>
  </StackPanel>
</UserControl>
