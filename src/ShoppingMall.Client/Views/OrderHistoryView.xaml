<!-- 주문내역. 위: 제목·버튼 / 아래: 선택한 주문의 상품 / 가운데: 주문 목록 표 -->
<UserControl x:Class="ShoppingMall.Client.Views.OrderHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="12">
    <!-- 위쪽 한 줄: 왼쪽에 제목, 오른쪽 끝에 버튼들 (Dock=Right 인 것을 먼저 넣어야 오른쪽에 붙는다) -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="새로고침" Click="Refresh_Click" />
        <Button x:Name="CancelButton" Content="주문취소" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click" />
      </StackPanel>
      <TextBlock Text="[주문내역]" Style="{StaticResource Title}" />
    </DockPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock x:Name="DetailTitle" Text="주문 상품" FontWeight="Bold" />
      <ListBox x:Name="LineList" Height="150" Margin="0,8,0,0" Padding="4" />
    </StackPanel>

    <DataGrid x:Name="Table" SelectionChanged="Table_SelectionChanged">
      <DataGrid.Columns>
        <DataGridTextColumn Header="주문번호" Binding="{Binding OrderId}" Width="Auto" />
        <DataGridTextColumn Header="주문일시" Binding="{Binding OrderedAt}" Width="2*" />
        <DataGridTextColumn Header="상태" Binding="{Binding StatusText}" Width="*" />
        <DataGridTextColumn Header="결제금액" Binding="{Binding TotalText}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
