<!-- 게시글 작성/수정 대화상자 -->
<Window x:Class="ShoppingMall.Client.Views.BoardWriteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontSize="14"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="20">
    <TextBlock Text="제목" />
    <TextBox x:Name="TitleBox" Margin="0,4,0,0" />
    <TextBlock Text="내용" Margin="0,12,0,0" />
    <!-- 여러 줄 입력: AcceptsReturn 으로 Enter 줄바꿈, 넘치면 세로 스크롤 -->
    <TextBox x:Name="ContentBox" Height="260" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap"
             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="저장" Click="Save_Click" />
      <Button Content="취소" IsCancel="True" Margin="8,0,0,0" />
    </StackPanel>
  </StackPanel>
</Window>
