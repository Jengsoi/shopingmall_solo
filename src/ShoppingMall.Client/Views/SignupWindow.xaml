<!-- 회원가입 대화상자. 아이디 중복확인을 통과해야 가입할 수 있다. -->
<Window x:Class="ShoppingMall.Client.Views.SignupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontSize="14"
        Title="회원가입" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="20">
    <TextBlock Text="[회원가입]" Style="{StaticResource Title}" Margin="0,0,0,16" />

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <!-- 이 Grid 안의 TextBlock(라벨)은 모두 Label 스타일. 행 사이 간격은 둘째 행부터 위쪽 여백 8 로 준다. -->
      <Grid.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource Label}" />
      </Grid.Resources>

      <TextBlock Text="아이디" />
      <!-- 아이디 입력칸(남은 폭) + 중복확인 버튼 -->
      <DockPanel Grid.Column="1">
        <Button Content="중복확인" DockPanel.Dock="Right" Margin="8,0,0,0" Click="CheckId_Click" />
        <TextBox x:Name="LoginIdBox" TextChanged="LoginIdBox_TextChanged" />
      </DockPanel>

      <TextBlock Text="비밀번호" Grid.Row="1" Margin="0,8,12,0" />
      <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" />

      <TextBlock Text="비밀번호 확인" Grid.Row="2" Margin="0,8,12,0" />
      <PasswordBox x:Name="PasswordConfirmBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" />

      <TextBlock Text="이름" Grid.Row="3" Margin="0,8,12,0" />
      <TextBox x:Name="NameBox" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" />

      <TextBlock Text="주소" Grid.Row="4" Margin="0,8,12,0" />
      <TextBox x:Name="AddressBox" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" />

      <TextBlock Text="이메일" Grid.Row="5" Margin="0,8,12,0" />
      <TextBox x:Name="EmailBox" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" />

      <TextBlock Text="전화번호" Grid.Row="6" Margin="0,8,12,0" />
      <TextBox x:Name="PhoneBox" Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" />

      <TextBlock Text="성별" Grid.Row="7" Margin="0,8,12,0" />
      <!-- 항목 순서는 코드의 GenderCodes 와 짝이 맞아야 한다 -->
      <ComboBox x:Name="GenderBox" Grid.Row="7" Grid.Column="1" Margin="0,8,0,0" SelectedIndex="0">
        <ComboBoxItem Content="선택 안 함" />
        <ComboBoxItem Content="남성" />
        <ComboBoxItem Content="여성" />
      </ComboBox>
    </Grid>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="가입하기" Click="Signup_Click" />
      <Button Content="취소" IsCancel="True" Margin="8,0,0,0" />
    </StackPanel>
  </StackPanel>
</Window>
