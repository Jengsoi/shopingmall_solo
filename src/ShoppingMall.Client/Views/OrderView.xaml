<!-- 주문/결제 확인 화면. 위: 제목 / 아래: 배송 정보·결제 금액·버튼 / 가운데: 주문할 상품 목록 -->
<UserControl x:Class="ShoppingMall.Client.Views.OrderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Text="[주문/결제]" Style="{StaticResource Title}" Margin="0,0,0,8" />

    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <TextBlock x:Name="NameText" />
      <TextBlock x:Name="PhoneText" Margin="0,4,0,0" />
      <TextBlock x:Name="AddressText" Margin="0,4,0,0" />
      <TextBlock x:Name="TotalText" Text="결제 금액: 0원" FontSize="16" FontWeight="Bold" Margin="0,8,0,0" />
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <Button Content="뒤로가기" Click="Back_Click" />
        <Button Content="결제하기" Click="Pay_Click" Margin="8,0,0,0" />
      </StackPanel>
    </StackPanel>

    <ListBox x:Name="ItemList" FontSize="14" Padding="4" />
  </DockPanel>
</UserControl>
