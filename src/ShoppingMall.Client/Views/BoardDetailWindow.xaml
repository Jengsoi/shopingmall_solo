<!-- 게시글 상세보기 + 댓글. 내용이 창보다 길어지면 스크롤할 수 있게 ScrollViewer 로 감싼다. -->
<Window x:Class="ShoppingMall.Client.Views.BoardDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontSize="14"
        Title="게시글 보기" Width="580" Height="720"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20">
      <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" TextWrapping="Wrap" />
      <TextBlock x:Name="MetaText" Foreground="#666666" Margin="0,4,0,0" />
      <!-- 읽기 전용 본문 (글자 선택·복사는 가능) -->
      <TextBox x:Name="ContentBox" Height="170" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap"
               VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
        <Button Content="수정" Click="EditPost_Click" />
        <Button Content="삭제" Click="DeletePost_Click" Margin="8,0,0,0" />
      </StackPanel>

      <TextBlock Text="댓글" FontWeight="Bold" Margin="0,12,0,0" />
      <!-- 항목은 CommentInfo.ToString() 결과("작성자 : 내용 (작성일)")로 표시된다 -->
      <ListBox x:Name="CommentList" Height="150" Margin="0,6,0,0" />
      <TextBox x:Name="NewCommentBox" Height="60" Margin="0,8,0,0" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalContentAlignment="Top" ToolTip="댓글 내용" />
      <!-- 댓글 버튼 줄: 왼쪽에 [댓글 등록], 오른쪽 끝에 [댓글 수정][댓글 삭제] -->
      <DockPanel Margin="0,8,0,0">
        <Button Content="댓글 등록" Click="AddComment_Click" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="댓글 수정" Click="EditComment_Click" />
          <Button Content="댓글 삭제" Click="DeleteComment_Click" Margin="8,0,0,0" />
        </StackPanel>
      </DockPanel>

      <!-- IsCancel: 누르거나 Esc 를 누르면 창이 닫힌다 -->
      <Button Content="닫기" IsCancel="True" HorizontalAlignment="Right" Margin="0,16,0,0" />
    </StackPanel>
  </ScrollViewer>
</Window>
