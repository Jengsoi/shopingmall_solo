<!--
  일반 회원 화면. 탭 5개와, 장바구니에서 "구매" 를 누르면 탭 대신 잠시 보여주는 주문·결제 화면(OrderHost)으로 이루어진다.
  두 개를 같은 자리에 겹쳐 두고 Visibility 로 하나만 보이게 한다.
  각 탭의 내용(화면)은 서버 API 객체가 필요해서 코드비하인드에서 넣는다.
-->
<UserControl x:Class="ShoppingMall.Client.Views.ShopShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="8">
    <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
      <TabControl.Resources>
        <!-- 탭 제목만 크게. (TabItem 에 FontSize 를 주면 탭 안의 내용까지 커지므로 제목 템플릿에만 준다) -->
        <Style TargetType="TabItem">
          <Setter Property="Padding" Value="16,6" />
          <Setter Property="HeaderTemplate">
            <Setter.Value>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontSize="15" />
              </DataTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </TabControl.Resources>
      <TabItem x:Name="ProductsTab" Header="상품페이지" />
      <TabItem x:Name="CartTab" Header="장바구니" />
      <TabItem x:Name="OrdersTab" Header="주문내역" />
      <TabItem x:Name="MemberTab" Header="내 정보" />
      <TabItem x:Name="BoardTab" Header="게시판" />
    </TabControl>

    <ContentControl x:Name="OrderHost" Visibility="Collapsed" />
  </Grid>
</UserControl>
