<!-- 게시판 목록. 위: 제목·검색·버튼 / 아래: 페이지 이동 / 가운데: 글 목록 표 (더블클릭하면 상세 창) -->
<UserControl x:Class="ShoppingMall.Client.Views.BoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="12">
    <!-- 위쪽 한 줄: [제목] [검색어(남은 폭)] [검색] [글쓰기] [새로고침] -->
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock Text="[게시판]" Style="{StaticResource Title}" Margin="0,0,12,0" />
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="검색" Margin="8,0,0,0" Click="Search_Click" />
        <Button Content="글쓰기" Margin="8,0,0,0" Click="Write_Click" />
        <Button Content="새로고침" Margin="8,0,0,0" Click="Refresh_Click" />
      </StackPanel>
      <TextBox x:Name="KeywordBox" KeyDown="KeywordBox_KeyDown" ToolTip="제목 검색어 (Enter 로 검색)" />
    </DockPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
      <Button x:Name="PrevButton" Content="이전" MinWidth="70" Click="Prev_Click" />
      <TextBlock x:Name="PageText" Text="1 페이지" VerticalAlignment="Center" Margin="12,0" />
      <Button x:Name="NextButton" Content="다음" MinWidth="70" Click="Next_Click" />
    </StackPanel>

    <DataGrid x:Name="Table" MouseDoubleClick="Table_MouseDoubleClick" SelectionChanged="Table_SelectionChanged">
      <DataGrid.Columns>
        <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="4*" />
        <DataGridTextColumn Header="작성자" Binding="{Binding Author}" Width="1.2*" />
        <DataGridTextColumn Header="작성일" Binding="{Binding CreatedAt}" Width="2*" />
        <DataGridTextColumn Header="댓글" Binding="{Binding CommentCount}" Width="Auto" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
