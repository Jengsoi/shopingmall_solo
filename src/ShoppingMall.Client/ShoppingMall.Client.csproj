<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPF 데스크톱 클라이언트. WPF 는 Windows 전용이라 대상 프레임워크가 net8.0-windows 다.
    화면 배치는 .xaml, 동작은 같은 이름의 .xaml.cs(코드비하인드)에 있다.
    서버 통신·모델은 ShoppingMall.Client.Core 를 그대로 쓴다.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ShoppingMall.Client.Core\ShoppingMall.Client.Core.csproj" />
  </ItemGroup>

</Project>
