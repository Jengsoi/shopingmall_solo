<!-- 관리자 화면. 위: "관리자 모드 (이름)" + 로그아웃 / 아래: 탭 3개 (각 탭 내용은 코드에서 넣는다) -->
<UserControl x:Class="ShoppingMall.Client.Admin.AdminShell"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="8">
    <DockPanel DockPanel.Dock="Top" Margin="4,0,4,8">
      <Button Content="로그아웃" DockPanel.Dock="Right" Click="Logout_Click" />
      <TextBlock x:Name="HeaderText" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
    </DockPanel>

    <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">
      <TabControl.Resources>
        <!-- 탭 제목만 크게. (TabItem 에 FontSize 를 주면 탭 안의 내용까지 커지므로 제목 템플릿에만 준다) -->
        <Style TargetType="TabItem">
          <Setter Property="Padding" Value="16,6" />
          <Setter Property="HeaderTemplate">
            <Setter.Value>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontSize="15" />
              </DataTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </TabControl.Resources>
      <TabItem x:Name="DashboardTab" Header="📊 매출 현황 (대시보드)" />
      <TabItem x:Name="InventoryTab" Header="📦 재고 관리" />
      <TabItem x:Name="OrdersTab" Header="🧾 주문 관리" />
    </TabControl>
  </DockPanel>
</UserControl>
