<!-- 주문 관리. 위: 제목 / 상태 필터·새로고침 ...... 다음 단계·주문취소 / 아래: 주문 상품 / 가운데: 주문 목록 -->
<UserControl x:Class="ShoppingMall.Client.Admin.OrderManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
      <TextBlock Text="주문관리" Style="{StaticResource Title}" Margin="0,0,0,8" />
      <DockPanel>
        <TextBlock Text="상태" Style="{StaticResource Label}" />
        <ComboBox x:Name="FilterBox" Width="140" SelectionChanged="FilterBox_SelectionChanged" />
        <Button Content="새로고침" Margin="8,0,0,0" Click="Refresh_Click" />
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
          <!-- 글자는 선택한 주문에 따라 "→ 배송준비중" 처럼 바뀐다 -->
          <Button x:Name="AdvanceButton" Content="다음 단계로" MinWidth="140" IsEnabled="False" Click="Advance_Click" />
          <Button x:Name="CancelButton" Content="주문취소" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click" />
        </StackPanel>
      </DockPanel>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
      <TextBlock x:Name="DetailTitle" Text="주문 상품" FontWeight="Bold" />
      <ListBox x:Name="LineList" Height="140" Margin="0,8,0,0" Padding="4" />
    </StackPanel>

    <DataGrid x:Name="Table" SelectionChanged="Table_SelectionChanged">
      <DataGrid.Columns>
        <DataGridTextColumn Header="주문번호" Binding="{Binding OrderId}" Width="Auto" />
        <DataGridTextColumn Header="주문일시" Binding="{Binding OrderedAt}" Width="1.5*" />
        <DataGridTextColumn Header="주문자" Binding="{Binding MemberText}" Width="1.5*" />
        <DataGridTextColumn Header="상태" Binding="{Binding StatusText}" Width="Auto" />
        <DataGridTextColumn Header="결제금액" Binding="{Binding TotalText}" Width="*" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
