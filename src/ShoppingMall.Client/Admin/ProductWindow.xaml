<!-- 상품 추가/수정 대화상자 -->
<Window x:Class="ShoppingMall.Client.Admin.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontSize="14"
        Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <StackPanel Margin="20">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource Label}" />
      </Grid.Resources>

      <TextBlock Text="카테고리" />
      <!-- DisplayMemberPath: 항목(AdminCategory)의 Name 속성을 글자로 보여준다 -->
      <ComboBox x:Name="CategoryBox" Grid.Column="1" DisplayMemberPath="Name" />

      <TextBlock Text="상품명" Grid.Row="1" Margin="0,8,12,0" />
      <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" />

      <TextBlock Text="설명" Grid.Row="2" Margin="0,8,12,0" VerticalAlignment="Top" />
      <TextBox x:Name="DescriptionBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Height="70"
               AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />

      <TextBlock Text="색상" Grid.Row="3" Margin="0,8,12,0" />
      <TextBox x:Name="ColorBox" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" />

      <TextBlock Text="사이즈" Grid.Row="4" Margin="0,8,12,0" />
      <TextBox x:Name="SizeBox" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" />

      <TextBlock Text="가격(원)" Grid.Row="5" Margin="0,8,12,0" />
      <TextBox x:Name="PriceBox" Grid.Row="5" Grid.Column="1" Margin="0,8,0,0" Text="0" HorizontalContentAlignment="Right" />

      <TextBlock Text="재고수량" Grid.Row="6" Margin="0,8,12,0" />
      <TextBox x:Name="StockBox" Grid.Row="6" Grid.Column="1" Margin="0,8,0,0" Text="0" HorizontalContentAlignment="Right" />
    </Grid>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="확인" Click="Ok_Click" />
      <Button Content="취소" IsCancel="True" Margin="8,0,0,0" />
    </StackPanel>
  </StackPanel>
</Window>
