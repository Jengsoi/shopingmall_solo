<!--
  앱 전체 설정. 화면 자체는 XAML 이 아니라 C# 코드로 만들고, 여기서는 테마(스타일)만 불러온다.
  RequestedThemeVariant="Default" : 운영체제의 밝은/어두운 테마 설정을 따른다.
-->
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ShoppingMall.Client.App"
             RequestedThemeVariant="Default">
  <Application.Styles>
    <!-- 기본 컨트롤(버튼, 입력칸 등)의 Fluent 디자인 -->
    <FluentTheme />
    <!-- DataGrid(표)는 별도 패키지라 스타일도 따로 불러와야 화면에 보인다 -->
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
  </Application.Styles>
</Application>
